    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\nconst items = $('HTTP Request').all();\n\nif (items.length > 0) {\n  staticData.last_message_id = items[0].json.id;\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        -64
      ],
      "id": "d34cfeb8-15e6-4986-a54e-5f62459b5a46",
      "name": "Save last_message_id"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n// Get the original items from your Filter node to match 1:1\nconst filterItems = $('Filter').all();\n\nreturn items.map((item, index) => {\n  // Grab the corresponding original message data\n  const originalData = filterItems[index] ? filterItems[index].json : {};\n  \n  let parsedObj = {};\n  try {\n    // Extract and clean the LLM's text output\n    const rawText = item.json.text || item.json.response || \"{}\";\n    const cleanedText = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\n    parsedObj = JSON.parse(cleanedText);\n  } catch (e) {\n    // Fallback if JSON parsing fails\n    parsedObj = {\n      classify: \"General Inquiry\",\n      draft: item.json.text || \"Could not generate draft.\",\n      flag: \"LOW\"\n    };\n  }\n\n  // Return a clean, unified object containing metadata + AI results\n  return { \n    json: {\n      message_id: originalData.id || \"\",\n      content: originalData.content || \"\",\n      ...parsedObj\n    } \n  };\n});"
      },
