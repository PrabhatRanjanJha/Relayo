        "jsCode": "const items = $input.all();\n\nconst counts = items.reduce((acc, item) => {\n  const source = item.json.source;\n  acc[source] = (acc[source] || 0) + 1;\n  return acc;\n}, {});\n\nreturn [{\n  json: {\n    counts: counts,\n    total: items.length\n  }\n}];"
      },
